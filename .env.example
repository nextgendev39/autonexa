# Public Supabase settings. These values are exposed to the browser.
# Copy this file to .env.local and replace the placeholders. Do not commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use either the legacy anon key or the dashboard "publishable" key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional. Used as the password-reset redirect origin when the request has no Origin header.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Server-only. Never prefix with NEXT_PUBLIC_.
# Required for the hidden first Super Admin bootstrap page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# At least 16 characters. Leave empty to disable /setup/bootstrap (returns 404).
BOOTSTRAP_SECRET=change-me-to-a-long-random-secret
# Entered on the same /setup/super-admin page, this creates the first AutoNexa platform owner instead.
# At least 16 characters, and different from BOOTSTRAP_SECRET. Clear both once setup is done.
PLATFORM_BOOTSTRAP_SECRET=

# Do not add SUPABASE_SERVICE_ROLE_KEY anywhere with a NEXT_PUBLIC_ prefix.
# Supabase CLI deployment uses `npx supabase link` and its own migration history.

# Optional server-side Drizzle queries. Must target the SAME Supabase project above.
# Direct/session pooler PostgreSQL URL; percent-encode URL-special password characters.
# The login role must be allowed to SET ROLE authenticated. Request queries always
# run inside an authenticated, transaction-local RLS context, never as the login role.
DATABASE_URL=
# Privileged connection for schema checks and Studio. Never exposed to the browser.
# Falls back to DATABASE_URL if omitted. Use a direct or session pooler connection.
DATABASE_MIGRATION_URL=

# Outgoing email (server-only, any SMTP provider). Never prefix with NEXT_PUBLIC_.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AutoNexa

# Server-only key for hashing email verification codes (HMAC-SHA256).
# Generate with: openssl rand -hex 32. Changing it invalidates pending codes.
EMAIL_VERIFICATION_SECRET=

# Web push for booking payment alerts (deposit / full payment deadlines).
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: or https: URL.
VAPID_SUBJECT=mailto:admin@example.com

# Optional. Enables GET /api/cron/booking-deadlines for an hourly scheduler
# (send "Authorization: Bearer <CRON_SECRET>"). Generate with: openssl rand -hex 32
CRON_SECRET=

# Public dealership websites. Dealerships live at <slug>.<this domain>. Leave empty to keep the
# websites off: every host then serves the staff app, as it always has.
NEXT_PUBLIC_STOREFRONT_BASE_DOMAIN=
# Once that's set, ANY host not listed here is treated as a dealership website. List every host that
# serves the staff app, comma separated. "*.example.com" matches subdomains, for preview deployments.
# NEXT_PUBLIC_SITE_URL's host, localhost and 127.0.0.1 are included automatically.
APP_HOSTS=
# Where dealerships point their custom domain's CNAME record. Shown in their domain instructions.
NEXT_PUBLIC_STOREFRONT_CNAME_TARGET=
# Server-only. Keys the daily visitor hash for website analytics. Generate with: openssl rand -hex 32
STOREFRONT_ANALYTICS_SALT=

# Subscription payments. off, test or live. Off is the default: nothing can be bought.
BILLING_MODE=off
# Test mode only: the dealerships allowed to check out, by slug. Test cards always succeed, so this
# stops a misconfigured environment handing real dealerships paid plans for free.
BILLING_TEST_TENANT_SLUGS=
# Live mode also needs this set to "yes", and live keys. Don't set either without a decision to go live.
BILLING_LIVE_APPROVED=
# Server only, all of them. Never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Which gateway serves each currency. These are the defaults.
BILLING_GATEWAY_AED=stripe
BILLING_GATEWAY_INR=razorpay

# Where demo requests from the landing page are emailed. Falls back to SMTP_FROM_EMAIL, and needs SMTP set up.
# Every request is also stored and listed under Platform > Demo requests (needs SUPABASE_SERVICE_ROLE_KEY).
LANDING_LEADS_EMAIL=
